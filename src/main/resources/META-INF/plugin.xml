<idea-plugin>
    <id>com.example.jsontransformer</id>
    <name>JSON Transformer</name>
    <vendor email="you@example.com" url="https://example.com">Your Name</vendor>
    <version>1.0.0</version>

    <description><![CDATA[
        <p>在 IDE 内部将 JSON 在多种表格布局之间转换，复刻 <b>tableconvert.com</b> 的 “JSON to JSON” 工具。</p>
        <ul>
            <li>四种布局互转：对象数组 / 二维数组 / 列数组 / 键值数组</li>
            <li>输入格式自动识别</li>
            <li>可设置缩进（2 / 4 / 8 空格、Tab）、压缩输出、根对象名</li>
            <li>支持“智能解析单元格中的 JSON 字符串”</li>
            <li>编辑器右键 “Convert JSON Selection” 一键转换选中内容</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="JSON Transformer" displayType="BALLOON"/>
        <toolWindow id="JSON Transformer"
                    anchor="right"
                    icon="/icons/pluginIcon.svg"
                    factoryClass="com.example.jsontransformer.JsonTransformerToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.example.jsontransformer.OpenJsonTransformer"
                class="com.example.jsontransformer.OpenJsonTransformerAction"
                text="Open JSON Transformer"
                description="Open the JSON Transformer tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="com.example.jsontransformer.ConvertEditorSelection"
                class="com.example.jsontransformer.ConvertEditorSelectionAction"
                text="Convert JSON Selection"
                description="Send the editor selection to the JSON Transformer">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
